# Copy this to ".env" in the backend/ folder and fill in real values.
# NOTE: unlike the earlier standalone scripts, this app does NOT store
# YOUR Ventura credentials here. Each user (you + friends) enters their
# own app key / secret / PIN / TOTP secret through the login page.
# This file only holds settings for the server itself.

# Postgres connection string. Example for a local Postgres on your VM:
# postgresql://screener_user:yourpassword@localhost:5432/screener_db
DATABASE_URL=

# A random encryption key used to encrypt each user's stored Ventura
# credentials in the database (so a DB leak doesn't leak plaintext
# secrets/PINs). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Set to "true" once you're running behind HTTPS (recommended before
# any friends log in with real credentials). Keep "false" while testing
# locally over plain http.
COOKIE_SECURE=false
